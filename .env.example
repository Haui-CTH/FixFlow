# DX-FSM Environment Variables
# Copy to .env and customize
# DO NOT COMMIT .env — only commit .env.example
#
# === Security Notice ===
# Mọi password/secret PHẢI qua env var. KHÔNG hardcode trong docker-compose.yml
# hoặc source code. Khi tạo .env lần đầu, dùng:
#   openssl rand -base64 32
# để sinh password mạnh.
#
# Rotation policy: mỗi 90 ngày (xem docs/SECURITY.md).

# === PostgreSQL ===
POSTGRES_DB=dxfsm
POSTGRES_USER=dxfsm
POSTGRES_PASSWORD=<CHANGE_ME_postgres_32_chars_min>

# === Keycloak admin ===
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<CHANGE_ME_keycloak_32_chars_min>

# === MinIO ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<CHANGE_ME_minio_32_chars_min>

# === n8n ===
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=<CHANGE_ME_n8n_32_chars_min>

# === Keycloak confidential client (dx-fsm-api) ===
# Generate with: openssl rand -hex 32
# JWT verify dùng public key từ JWKS nên secret này chỉ cần cho
# service-to-service call. Xem Keycloak admin → Clients → dx-fsm-api → Credentials
# để xem secret hiện tại.

# === Outbox alerting (B5.3) ===
ALERT_WEBHOOK_URL=<set_in_production>

# === Ollama (optional) ===
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
