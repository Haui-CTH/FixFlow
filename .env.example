# DX-FSM Environment Variables
# Copy to .env and customize
# DO NOT COMMIT .env — only commit .env.example
#
# === Security Notice ===
# Mọi password/secret PHẢI qua env var. KHÔNG hardcode trong docker-compose.yml
# hoặc source code. Khi tạo .env lần đầu, dùng:
#   openssl rand -base64 32
# để sinh password mạnh.
#
# Rotation policy: mỗi 90 ngày (xem docs/SECURITY.md).

# === PostgreSQL ===
POSTGRES_DB=dxfsm
POSTGRES_USER=dxfsm
POSTGRES_PASSWORD=<CHANGE_ME_postgres_32_chars_min>

# === Keycloak admin ===
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<CHANGE_ME_keycloak_32_chars_min>

# === MinIO ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<CHANGE_ME_minio_32_chars_min>

# === n8n ===
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=<CHANGE_ME_n8n_32_chars_min>

# === Keycloak confidential client (dx-fsm-api) ===
# Generate with: openssl rand -hex 32
# JWT verify dùng public key từ JWKS nên secret này chỉ cần cho
# service-to-service call. Xem Keycloak admin → Clients → dx-fsm-api → Credentials
# để xem secret hiện tại.

# === Outbox alerting (B5.3) ===
ALERT_WEBHOOK_URL=<set_in_production>

# === Notification Service (B5.1) ===
# Email channel (SMTP)
NOTIFICATION_SMTP_HOST=mailhog
NOTIFICATION_SMTP_PORT=1025
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_SMTP_FROM=noreply@dx-fsm.local
NOTIFICATION_SMTP_USE_TLS=false
# SMS (stub in dev, set real provider in production)
NOTIFICATION_SMS_ENABLED=false
# Push (stub in dev, set real provider in production)
NOTIFICATION_PUSH_ENABLED=false
# Service-to-service auth (n8n / ticket-service)
# Leave empty in dev to skip auth; set in production
NOTIFICATION_SERVICE_TOKEN=

# === Ollama (optional) ===
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
